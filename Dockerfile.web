# syntax=docker/dockerfile:1

# ---- Build: optimized Angular production bundle -----------------------------------------
FROM node:24.22.2-alpine AS build
WORKDIR /app

# Dependencies first (cached layer), installed exactly as locked.
COPY FizzBuzz.Web/package.json FizzBuzz.Web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY FizzBuzz.Web/ ./
RUN npm run build -- --configuration production

# ---- Runtime: static files served by unprivileged Nginx (port 8080, non-root) ------------
FROM nginxinc/nginx-unprivileged:1.28-alpine AS runtime

COPY FizzBuzz.Web/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY FizzBuzz.Web/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist/fizzbuzz-web/browser /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
