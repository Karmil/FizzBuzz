<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.7204101">

  <PropertyGroup>
    <!-- F5 in Visual Studio: Angular dev server, /api proxied to the backend (proxy.conf.json). -->
    <StartupCommand>npm start</StartupCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\fizzbuzz-web\browser\</BuildOutputFolder>

    <!--
      The Angular toolchain is driven by npm (npm ci / npm run build / npm test) and by Dockerfile.web.
      Keeping it out of MSBuild lets `dotnet build` and `dotnet test` on the solution run without Node.js.
    -->
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
  </PropertyGroup>

</Project>
