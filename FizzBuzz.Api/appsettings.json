{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "FizzBuzz": {
    "MaxLimit": 10000
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Https": {
    "RedirectionEnabled": true
  }
}
